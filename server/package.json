{
  "name": "max-upgrader-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сервер MAX Upgrader: аккаунты, облачный прогресс, экономика",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "tsx test/rtp.ts && tsx test/run.ts && tsx test/play.ts && tsx test/versus.ts",
    "test:rtp": "tsx test/rtp.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
